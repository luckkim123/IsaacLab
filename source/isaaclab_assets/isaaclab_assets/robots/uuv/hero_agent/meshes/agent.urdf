        <!-- Joint3 (buoy fixer) -->  
    <joint name="buoy_fixer" type="fixed">
        <parent link="link2"/>
        <child link="link3"/>
        <origin xyz="0.233 0 0.01" rpy="0 0 0"/>
    </joint>

    <!-- Link3 (buoy) -->
    <!-- Buoy sized for near-neutral buoyancy: mass=1.0kg -->
    <!-- Cylinder: r=0.085m, h=0.09m -> V=pi*0.085^2*0.09=0.00204m^3 -->
    <link name="link3">
        <visual>
            <origin xyz="0 0 0.055" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.09" radius="0.085"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0.055" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.09" radius="0.085"/>
            </geometry>
        </collision>

        <inertial>
        <origin xyz="0 0 0.055" rpy="0 0 0"/>
        <!-- Buoy mass: 0.93kg for neutral system buoyancy -->
        <mass value="0.93"/>
        <!-- Cylinder inertia: r=0.085m, h=0.09m, m=0.93kg -->
        <!-- Ixx=Iyy=(1/12)*m*(3r^2+h^2)=0.00231, Izz=(1/2)*m*r^2=0.00336 -->
        <inertia
        ixx="0.00231" ixy="0.0" ixz="0.0"
        iyy="0.00231" iyz="0.0"
        izz="0.00336"/>
        </inertial>
    </link>
